# API keys of the LLM providers listed in configs/providers.json.
# Copy this file to .env and fill in the keys; .env is never committed.
#
# Several keys per provider: <PREFIX>_API_KEY, <PREFIX>_API_KEY_2,
# <PREFIX>_API_KEY_3, ... They are used in that order and rotated on rate
# limits. Empty values are ignored.

# Groq - https://console.groq.com/keys
GROQ_API_KEY=
GROQ_API_KEY_2=

# Google AI Studio (Gemini) - https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_API_KEY_2=

# OpenRouter - https://openrouter.ai/settings/keys
OPENROUTER_API_KEY=
OPENROUTER_API_KEY_2=

# Mistral - https://console.mistral.ai/api-keys
MISTRAL_API_KEY=
MISTRAL_API_KEY_2=

# GitHub Models - personal access token with the "Models" permission
GITHUB_MODELS_API_KEY=
GITHUB_MODELS_API_KEY_2=

# Cloudflare Workers AI - each key needs the account id with the same number
CLOUDFLARE_API_KEY=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_KEY_2=
CLOUDFLARE_ACCOUNT_ID_2=

# Nvidia NIM - https://build.nvidia.com
NVIDIA_API_KEY=
NVIDIA_API_KEY_2=
